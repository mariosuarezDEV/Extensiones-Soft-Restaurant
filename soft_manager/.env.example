# Copia a .env (no versionado) y completa los valores.
# IPs de Tailscale del SQL Server de cada sucursal
DB_HOST_CENTRO=
DB_HOST_ARAUCARIAS=
DB_HOST_ANAHUAC=
DB_PASSWORD=
# MongoDB publico en el puerto 27018: usuario y contrasena obligatorios
# (sin caracteres especiales de URL como @ : / ? # %)
MONGO_USER=admin
MONGO_PASSWORD=
# Opcionales
# DB_NAME=softrestaurant11
# DB_USER=sa
# DB_PORT=1433
# MONGO_URI=   (por defecto usa el contenedor mongo con MONGO_USER/MONGO_PASSWORD)
# HISTORIAL_API_URL=
